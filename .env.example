# Copy to .env (docker compose works without it thanks to defaults)
POSTGRES_USER=guardslm
POSTGRES_PASSWORD=guardslm_dev_password
POSTGRES_DB=guardslm
POSTGRES_PORT=5432

JWT_SECRET=change-me-in-real-deployments
JWT_EXPIRE_MINUTES=480

# Policy for cancelling an order that is already SHIPPED: BLOCK (403) or ASK (409 + decision=ASK)
CANCEL_SHIPPED_POLICY=BLOCK
RETURN_WINDOW_DAYS=14
REFUND_WINDOW_DAYS=30

# Dev/test only: enables POST /admin/dev/reset (re-seeds the database). Keep false in production.
ENABLE_DEV_RESET=true

VITE_API_URL=http://localhost:8000
